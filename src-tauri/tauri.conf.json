{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexBrain",
  "version": "1.0.0",
  "identifier": "com.hexbrain.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HexBrain - 英雄联盟海克斯极客辅助",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      },
      {
        "label": "ongoing-overlay",
        "title": "HexBrain 实时对局悬浮窗",
        "url": "index.html?window=overlay",
        "width": 1120,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "create": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob: https://game.gtimg.cn https://raw.communitydragon.org https://ddragon.leagueoflegends.com; font-src 'self' data:; connect-src 'self' ipc: tauri: http://localhost:* http://127.0.0.1:* https://game.gtimg.cn https://raw.communitydragon.org https://ddragon.leagueoflegends.com ws://localhost:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
